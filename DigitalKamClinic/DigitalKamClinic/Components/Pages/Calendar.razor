@page "/calendar"
@rendermode InteractiveServer

<PageTitle>Calendar - Dental Clinic</PageTitle>

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-md-12">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="ti ti-calendar me-2"></i>Appointment Calendar
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="ti ti-info-circle me-2"></i>
                        Calendar view coming soon. For now, please use the <a href="/appointments" class="alert-link">Appointments</a> page to manage scheduled appointments.
                    </div>

                    <div class="text-center py-5">
                        <i class="ti ti-calendar-event" style="font-size: 5rem; opacity: 0.3;"></i>
                        <h4 class="mt-3 text-muted">Calendar Integration In Progress</h4>
                        <p class="text-muted">This feature will display a visual calendar with all appointments.</p>
                        <a href="/appointments" class="btn btn-primary mt-3">
                            <i class="ti ti-list me-1"></i>View Appointments List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // Future implementation: Full calendar view with drag-and-drop appointment scheduling
}
