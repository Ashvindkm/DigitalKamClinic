@page "/patients/{PatientId:guid}"
@using DigitalKamClinic.Services.PatientService
@using DigitalKamClinic.Services.VisitService
@inject IPatientService PatientService
@inject IVisitService VisitService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>@patientName - Dental Clinic</PageTitle>

<div class="container-xxl flex-grow-1 container-p-y">
    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (patient == null)
    {
        <div class="alert alert-warning">
            <i class="ti ti-alert-triangle me-2"></i>Patient not found.
            <a href="/patients" class="alert-link">Return to patients list</a>
        </div>
    }
    else
    {
        <div class="row">
            <!-- Patient Information Card -->
            <div class="col-md-4">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="ti ti-user me-2"></i>Patient Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <h4>@patient.FullName</h4>
                            <span class="badge bg-success">Active</span>
                        </div>

                        @if (!string.IsNullOrEmpty(patient.PhoneNumber))
                        {
                            <div class="mb-3">
                                <label class="text-muted small">Phone</label>
                                <div>
                                    <strong><i class="ti ti-phone me-1"></i>@patient.PhoneNumber</strong>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(patient.Email))
                        {
                            <div class="mb-3">
                                <label class="text-muted small">Email</label>
                                <div>
                                    <strong><i class="ti ti-mail me-1"></i>@patient.Email</strong>
                                </div>
                            </div>
                        }
                        @if (patient.DateOfBirth.HasValue)
                        {
                            <div class="mb-3">
                                <label class="text-muted small">Date of Birth</label>
                                <div>
                                    <strong>@patient.DateOfBirth.Value.ToString("MMM dd, yyyy")</strong>
                                    <span class="text-muted ms-2">(@CalculateAge(patient.DateOfBirth.Value) years)</span>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(patient.Gender))
                        {
                            <div class="mb-3">
                                <label class="text-muted small">Gender</label>
                                <div><strong>@patient.Gender</strong></div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(patient.Address))
                        {
                            <div class="mb-3">
                                <label class="text-muted small">Address</label>
                                <div><strong>@patient.Address</strong></div>
                            </div>
                        }

                        <div class="mt-4">
                            <button class="btn btn-primary w-100 mb-2" @onclick="ScheduleAppointment">
                                <i class="ti ti-calendar-plus me-1"></i>Schedule Appointment
                            </button>
                            <button class="btn btn-outline-primary w-100" @onclick="RecordVisit">
                                <i class="ti ti-clipboard-plus me-1"></i>Record Visit
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Medical Information Card -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="ti ti-heart-rate-monitor me-2"></i>Medical Information</h6>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(patient.Allergies))
                        {
                            <div class="mb-3">
                                <label class="text-muted small">Allergies</label>
                                <div class="alert alert-warning mb-0 mt-1 py-2">
                                    <small>@patient.Allergies</small>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(patient.MedicalConditions))
                        {
                            <div class="mb-3">
                                <label class="text-muted small">Medical Conditions</label>
                                <div><small>@patient.MedicalConditions</small></div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(patient.Medications))
                        {
                            <div class="mb-3">
                                <label class="text-muted small">Current Medications</label>
                                <div><small>@patient.Medications</small></div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Treatment History -->
            <div class="col-md-8">
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="ti ti-history me-2"></i>Treatment History</h5>
                        <button class="btn btn-sm btn-primary" @onclick="RecordVisit">
                            <i class="ti ti-plus me-1"></i>Add Visit
                        </button>
                    </div>
                    <div class="card-body">
                        @if (visits == null || !visits.Any())
                        {
                            <div class="alert alert-info">
                                <i class="ti ti-info-circle me-2"></i>No treatment history available. 
                                Click "Add Visit" to record this patient's first visit.
                            </div>
                        }
                        else
                        {
                            <!-- Timeline -->
                            <div class="timeline">
                                @foreach (var visit in visits.OrderByDescending(v => v.DateCreated))
                                {
                                    var visitDetails = GetVisitDetails(visit.Id);
                                    <div class="timeline-item mb-4">
                                        <div class="timeline-event">
                                            <div class="timeline-header mb-2">
                                                <h6 class="timeline-title">
                                                    @if (visit.DateCreated.HasValue)
                                                    {
                                                        <i class="ti ti-calendar-event me-1"></i>
                                                        @visit.DateCreated.Value.ToString("MMM dd, yyyy")
                                                    }
                                                </h6>
                                                <small class="text-muted">
                                                    @if (visit.DateCreated.HasValue)
                                                    {
                                                        @visit.DateCreated.Value.ToString("hh:mm tt")
                                                    }
                                                </small>
                                            </div>

                                            @if (visitDetails.Any())
                                            {
                                                <div class="card border">
                                                    <div class="card-body p-3">
                                                        @foreach (var detail in visitDetails)
                                                        {
                                                            <div class="mb-2">
                                                                @if (detail.Label == "Treatment")
                                                                {
                                                                    <strong><i class="ti ti-dental me-1"></i>Treatment:</strong>
                                                                    <p class="mb-1">@detail.Value1</p>
                                                                }
                                                                else if (detail.Label == "Notes")
                                                                {
                                                                    <strong><i class="ti ti-notes me-1"></i>Notes:</strong>
                                                                    <p class="mb-1">@detail.Value1</p>
                                                                }
                                                                else if (detail.Label == "NextVisitAdvice")
                                                                {
                                                                    <div class="alert alert-info mb-0 py-2">
                                                                        <strong><i class="ti ti-info-circle me-1"></i>Next Visit Advice:</strong>
                                                                        <p class="mb-0 mt-1">@detail.Value1</p>
                                                                    </div>
                                                                }
                                                                else if (detail.Label == "Prescription")
                                                                {
                                                                    <strong><i class="ti ti-pill me-1"></i>Prescription:</strong>
                                                                    <p class="mb-1">@detail.Value1</p>
                                                                }
                                                                else
                                                                {
                                                                    <strong>@detail.Label:</strong>
                                                                    <span>@detail.Value1</span>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <p class="text-muted">No details recorded for this visit.</p>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid PatientId { get; set; }

    private Patient? patient;
    private List<Visit> visits = new();
    private Dictionary<Guid, List<VisitDetail>> visitDetailsMap = new();
    private string patientName = "Patient";
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPatientData();
        isLoading = false;
    }

    private async Task LoadPatientData()
    {
        // Load patient entity
        var patientResponse = await PatientService.GetPatientByIdAsync(PatientId);
        if (!patientResponse.Success || patientResponse.Data == null)
        {
            return;
        }

        patient = patientResponse.Data;
        patientName = patient.FullName ?? "Patient";

        // Load visits for this patient
        var visitsResponse = await VisitService.GetVisitsByPatientAsync(PatientId);
        if (visitsResponse.Success && visitsResponse.Data != null)
        {
            visits = visitsResponse.Data;

            if (visits.Any())
            {
                // Load visit details
                var visitIds = visits.Select(v => v.Id).ToList();
                var visitDetailsResponse = await VisitService.GetVisitDetailsMapAsync(visitIds);
                if (visitDetailsResponse.Success && visitDetailsResponse.Data != null)
                {
                    visitDetailsMap = visitDetailsResponse.Data;
                }
            }
        }
    }

    private List<VisitDetail> GetVisitDetails(Guid visitId)
    {
        return visitDetailsMap.TryGetValue(visitId, out var details) ? details : new List<VisitDetail>();
    }

    private int CalculateAge(DateTime dateOfBirth)
    {
        var today = DateTime.Today;
        var age = today.Year - dateOfBirth.Year;
        if (dateOfBirth.Date > today.AddYears(-age)) age--;
        return age;
    }

    private void ScheduleAppointment()
    {
        Navigation.NavigateTo($"/appointments/new?patientId={PatientId}");
    }

    private void RecordVisit()
    {
        Navigation.NavigateTo($"/visits/new?patientId={PatientId}");
    }
}

<style>
    .timeline {
        position: relative;
        padding-left: 30px;
    }

    .timeline::before {
        content: '';
        position: absolute;
        left: 8px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: #e0e0e0;
    }

    .timeline-item {
        position: relative;
    }

    .timeline-item::before {
        content: '';
        position: absolute;
        left: -25px;
        top: 5px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #696cff;
        border: 2px solid #fff;
        box-shadow: 0 0 0 2px #696cff;
    }
</style>
