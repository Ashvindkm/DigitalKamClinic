@page "/patients"
@using DigitalKamClinic.Data
@using DigitalKamClinic.Shared.Entities
@using Microsoft.EntityFrameworkCore
@inject DataContext DbContext
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Patients - Dental Clinic</PageTitle>

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-md-12">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="ti ti-user-heart me-2"></i>Patients
                    </h5>
                    <button type="button" class="btn btn-primary" @onclick="NavigateToNewPatient">
                        <i class="ti ti-plus me-1"></i>New Patient
                    </button>
                </div>
                <div class="card-body">
                    <!-- Search Bar -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text"><i class="ti ti-search"></i></span>
                                <input type="text" class="form-control" placeholder="Search patients..." 
                                       @bind="searchTerm" @bind:event="oninput" @onkeyup="FilterPatients" />
                            </div>
                        </div>
                    </div>

                    @if (isLoading)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else if (filteredPatients == null || !filteredPatients.Any())
                    {
                        <div class="alert alert-info">
                            <i class="ti ti-info-circle me-2"></i>No patients found. Click "New Patient" to add your first patient.
                        </div>
                    }
                    else
                    {
                        <!-- Patient Table -->
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Patient Name</th>
                                        <th>Contact</th>
                                        <th>Last Visit</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var patient in filteredPatients)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@patient.EntityName</strong>
                                            </td>
                                            <td>
                                                <span class="text-muted">@GetPatientContact(patient.Id)</span>
                                            </td>
                                            <td>
                                                @if (patient.DateModified.HasValue)
                                                {
                                                    <span>@patient.DateModified.Value.ToString("MMM dd, yyyy")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No visits</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-success">Active</span>
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-icon btn-outline-primary" 
                                                        @onclick="() => ViewPatient(patient.Id)"
                                                        title="View Patient">
                                                    <i class="ti ti-eye"></i>
                                                </button>
                                                <button class="btn btn-sm btn-icon btn-outline-info ms-1" 
                                                        @onclick="() => ScheduleAppointment(patient.Id)"
                                                        title="Schedule Appointment">
                                                    <i class="ti ti-calendar-plus"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination Info -->
                        <div class="mt-3">
                            <p class="text-muted">Showing @filteredPatients.Count() of @allPatients.Count() patients</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Entity> allPatients = new();
    private List<Entity> filteredPatients = new();
    private Dictionary<Guid, string> patientContacts = new();
    private string searchTerm = string.Empty;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
        isLoading = false;
    }

    private async Task LoadPatients()
    {
        try
        {
            // Load all entities that represent patients
            allPatients = await DbContext.Entities
                .OrderByDescending(e => e.DateCreated)
                .ToListAsync();

            filteredPatients = allPatients;

            // Load patient contact details
            var patientIds = allPatients.Select(p => p.Id).ToList();
            var contactDetails = await DbContext.EntityDetails
                .Where(ed => patientIds.Contains(ed.EntityId.Value) && 
                       (ed.Label == "Phone" || ed.Label == "Email"))
                .ToListAsync();

            foreach (var detail in contactDetails.Where(d => d.Label == "Phone" || d.Label == "Email"))
            {
                if (detail.EntityId.HasValue && !string.IsNullOrEmpty(detail.Value1))
                {
                    patientContacts[detail.EntityId.Value] = detail.Value1;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading patients: {ex.Message}");
        }
    }

    private void FilterPatients()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredPatients = allPatients;
        }
        else
        {
            filteredPatients = allPatients
                .Where(p => p.EntityName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true)
                .ToList();
        }
    }

    private string GetPatientContact(Guid patientId)
    {
        return patientContacts.TryGetValue(patientId, out var contact) ? contact : "N/A";
    }

    private void NavigateToNewPatient()
    {
        Navigation.NavigateTo("/patients/new");
    }

    private void ViewPatient(Guid patientId)
    {
        Navigation.NavigateTo($"/patients/{patientId}");
    }

    private void ScheduleAppointment(Guid patientId)
    {
        Navigation.NavigateTo($"/appointments/new?patientId={patientId}");
    }
}
