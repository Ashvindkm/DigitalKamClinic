@page "/patients"
@using DigitalKamClinic.Services.PatientService
@using DigitalKamClinic.Shared.Entities
@inject IPatientService PatientService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Patients - Dental Clinic</PageTitle>

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-md-12">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="ti ti-user-heart me-2"></i>Patients
                    </h5>
                    <button type="button" class="btn btn-primary" @onclick="NavigateToNewPatient">
                        <i class="ti ti-plus me-1"></i>New Patient
                    </button>
                </div>
                <div class="card-body">
                    <!-- Search Bar -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text"><i class="ti ti-search"></i></span>
                                <input type="text" class="form-control" placeholder="Search patients..." 
                                       @bind="searchTerm" @bind:event="oninput" @onkeyup="FilterPatients" />
                            </div>
                        </div>
                    </div>

                    @if (isLoading)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else if (filteredPatients == null || !filteredPatients.Any())
                    {
                        <div class="alert alert-info">
                            <i class="ti ti-info-circle me-2"></i>No patients found. Click "New Patient" to add your first patient.
                        </div>
                    }
                    else
                    {
                        <!-- Patient Table -->
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Patient Name</th>
                                        <th>Contact</th>
                                        <th>Last Visit</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var patient in filteredPatients)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@patient.FullName</strong>
                                            </td>
                                            <td>
                                                <span class="text-muted">@patient.PhoneNumber</span>
                                            </td>
                                            <td>
                                                @if (patient.DateModified.HasValue)
                                                {
                                                    <span>@patient.DateModified.Value.ToString("MMM dd, yyyy")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No visits</span>
                                                }
                                            </td>
                                            <td>
                                                @if (patient.IsActive)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactive</span>
                                                }
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-icon btn-outline-primary" 
                                                        @onclick="() => ViewPatient(patient.Id)"
                                                        title="View Patient">
                                                    <i class="ti ti-eye"></i>
                                                </button>
                                                <button class="btn btn-sm btn-icon btn-outline-info ms-1" 
                                                        @onclick="() => ScheduleAppointment(patient.Id)"
                                                        title="Schedule Appointment">
                                                    <i class="ti ti-calendar-plus"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination Info -->
                        <div class="mt-3">
                            <p class="text-muted">Showing @filteredPatients.Count() of @allPatients.Count() patients</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Patient> allPatients = new();
    private List<Patient> filteredPatients = new();
    private string searchTerm = string.Empty;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
        isLoading = false;
    }

    private async Task LoadPatients()
    {
        var patientsResponse = await PatientService.GetAllPatientsAsync();
        if (patientsResponse.Success && patientsResponse.Data != null)
        {
            allPatients = patientsResponse.Data;
            filteredPatients = allPatients;
        }
    }

    private void FilterPatients()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredPatients = allPatients;
        }
        else
        {
            filteredPatients = allPatients
                .Where(p => p.FirstName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true ||
                           p.LastName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true ||
                           p.PhoneNumber?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true)
                .ToList();
        }
    }

    private void NavigateToNewPatient()
    {
        Navigation.NavigateTo("/patients/new");
    }

    private void ViewPatient(Guid patientId)
    {
        Navigation.NavigateTo($"/patients/{patientId}");
    }

    private void ScheduleAppointment(Guid patientId)
    {
        Navigation.NavigateTo($"/appointments/new?patientId={patientId}");
    }
}
